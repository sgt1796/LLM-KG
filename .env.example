HOST_PORT=8000
OPENAI_API_KEY=

KG_GRAPH_HOST_PATH=./GABA_graph.json
KG_GRAPH_CONTAINER_PATH=/data/graph/graph.json

KG_CACHE_HOST_PATH=./.kg_cache
KG_CACHE_CONTAINER_PATH=/data/cache

KG_OPENAI_EMBED_MODEL=text-embedding-3-small
KG_ENABLE_LLM_ANSWER=true
KG_KGE_ENABLED=false

WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=120
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5
